<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <MSBuildCachePackageVersion Condition="'$(MSBuildCachePackageVersion)' == ''">0.1.340-preview</MSBuildCachePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.MSBuildCache.Local" Version="$(MSBuildCachePackageVersion)" />
    <PackageVersion Include="Microsoft.MSBuildCache.SharedCompilation" Version="$(MSBuildCachePackageVersion)" />
  </ItemGroup>
</Project>
